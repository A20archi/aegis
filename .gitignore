# ===== AEGIS repo: code + configs + small results only =====
# Large model weights / checkpoints (regenerable; exceed GitHub 100MB cap)
*.safetensors
*.pt
*.pth
*.ckpt
*.bin
*.onnx
outputs/
**/checkpoints/
**/pretrained_model/

# Datasets / caches
data/
datasets/
*.npz
*.hdf5
*.h5
*.lmdb
*.arrow

# Videos / recordings / sims
*.mp4
*.avi
*.gif
videos/
results/videos/
# EXCEPTION: curated base-vs-AEGIS demo footage (small, paper/deck assets) is tracked
!sib_vla/multivla/results_saved/videos/
!sib_vla/multivla/results_saved/videos/**/
!sib_vla/multivla/results_saved/videos/**/*.mp4

# Archives / transfer bundles
*.tar
*.tar.gz
*.tar.zst
*.zip
*.7z
transfer/

# Python envs / caches
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
*.egg-info/

# Secrets / local
.env
*.pem
*.key
wandb/

# Keep: *.py *.sh *.yaml *.yml *.md, configs/, and results/**/*.json (small eval JSONs + trackers)

# in-progress eval/ablation outputs (excluded per request)
sib_vla/results/allsuites/
sib_vla/results/diag_long/

# manim render cache (regenerable from manim_aegis.py)
sib_vla/presentation/_manim/
billing_err.txt
report.csv

# local A100 eval — verbose per-cell logs + transient cfgs (keep JSON/SUMMARY/figures/videos)
sib_vla/results/local_lplus/**/*.log
sib_vla/results/local_clean/**/*.log
sib_vla/results/local_clean/**/_cfg_*.yaml
sib_vla/results/local_lplus_video/*.log

# v2 sweep / rib_v2 training artifacts: keep eval JSONs, never logs or checkpoints
sib_vla/results/v2_sweep/**/*.log
sib_vla/results/rib_v2/

# training loss-curve logs (process logs, not eval results) — keep only referenced ACT RIB curves
*.train.json
!sib_vla/results/aegis_act_v2/**/*.train.json
# tiny-n exploratory vanilla pilots (superseded by 3-seed tables)
sib_vla/results/**/eval_vanilla_n[0-9].json
sib_vla/results/**/eval_vanilla_n1[0-9].json
SAVED_STATE.md
